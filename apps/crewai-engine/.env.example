# Firebase Service Account (also used for Vertex AI auth)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# Firebase Project ID
FIREBASE_PROJECT_ID=kisaansaathi-28cec

# ── Vertex AI Gemini (Recommended: uses Google Cloud credits via Service Account) ──
VERTEX_AI_PROJECT=kisaansaathi-28cec
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Set to "vertex_ai" (default) or "google" (if using consumer API key)
LLM_PROVIDER=vertex_ai

# Consumer Gemini API key (only needed if LLM_PROVIDER=google)
GOOGLE_API_KEY=

# Optional: Google Maps API Key for routing (fallbacks to OSRM/local data if not set)
GOOGLE_MAPS_API_KEY=

# Optional: Agmarknet API endpoint
AGMARKNET_API_URL=

